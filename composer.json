{
    "name": "nvl/primitives",
    "description": "Immutable application value objects, exact money, validation, and ISO reference catalogs for Laravel",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "laravel",
        "value-object",
        "money",
        "phone",
        "iban",
        "locale",
        "currency"
    ],
    "require": {
        "php": "^8.4",
        "brick/math": "^0.14 || ^0.15 || ^0.16 || ^0.17 || ^0.18",
        "brick/money": "^0.11 || ^0.14",
        "ext-ctype": "*",
        "ext-filter": "*",
        "ext-json": "*",
        "ext-mbstring": "*",
        "laravel/framework": "^13.0",
        "nesbot/carbon": "^2.72 || ^3.0",
        "nvl/core": "^7.0"
    },
    "require-dev": {
        "giggsey/libphonenumber-for-php": "^9.0",
        "jschaedl/iban-validation": "^2.7",
        "larastan/larastan": "^3.10",
        "laravel/pint": "^1.27",
        "mockery/mockery": "^1.6",
        "orchestra/testbench": "^11.0",
        "pestphp/pest": "^4.0",
        "pestphp/pest-plugin-laravel": "^4.0",
        "symfony/intl": "^7.0 || ^8.0",
        "symfony/polyfill-intl-icu": "^1.33"
    },
    "suggest": {
        "ext-intl": "Enables locale-aware monetary formatting through Brick Money.",
        "giggsey/libphonenumber-for-php": "Enables phone number validation and formatting (^9.0).",
        "jschaedl/iban-validation": "Enables IBAN validation and formatting (^2.7).",
        "symfony/intl": "Enables ISO country, currency, language, and locale reference data (^7.0 || ^8.0).",
        "symfony/polyfill-intl-icu": "Enables Symfony Intl on PHP without ext-intl (^1.33)."
    },
    "autoload": {
        "psr-4": {
            "Nvl\\Primitives\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Nvl\\Primitives\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "analyse": "phpstan analyse --memory-limit=2G",
        "format": "pint --parallel --format agent",
        "format:test": "pint --parallel --test --format agent",
        "quality": [
            "@format:test",
            "@analyse",
            "@test"
        ],
        "test": "pest --compact"
    },
    "extra": {
        "branch-alias": {
            "dev-main": "7.x-dev"
        },
        "laravel": {
            "providers": [
                "Nvl\\Primitives\\Providers\\PrimitivesServiceProvider"
            ]
        }
    },
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        },
        "sort-packages": true
    },
    "archive": {
        "exclude": [
            "/.temp",
            "/build",
            "/coverage",
            "/.phpunit.cache",
            "/.phpunit.result.cache",
            "/phpstan.neon.dist",
            "/phpunit.xml.dist",
            "/tests",
            "/.DS_Store",
            "/**/.DS_Store",
            "/.gitattributes",
            "/**/.gitattributes",
            "/.gitignore",
            "/**/.gitignore",
            "/**/.gitkeep",
            ".DS_Store"
        ]
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "homepage": "https://github.com/nvl-laravel-suite/primitives",
    "authors": [
        {
            "name": "Nicolas Vlachos",
            "homepage": "https://github.com/nicolasvlachos",
            "role": "Developer"
        }
    ],
    "support": {
        "source": "https://github.com/nvl-laravel-suite/primitives",
        "docs": "https://github.com/nvl-laravel-suite/primitives#readme",
        "issues": "https://github.com/nvl-laravel-suite/primitives/issues",
        "security": "https://github.com/nvl-laravel-suite/primitives/security/policy"
    }
}
